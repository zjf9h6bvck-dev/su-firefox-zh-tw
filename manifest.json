
{
  "manifest_version": 2,
  "name": "繁體中文網頁翻譯工具",
  "version": "1.0.1",
  "description": "通用繁體中文網頁翻譯擴充功能",
  "browser_specific_settings": {
    "gecko": {
      "id": "su-firefox-zh-tw@example.org",
      "strict_min_version": "78.0"
    },
    "gecko_android": {}
  },
  "permissions": [
    "https://example.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://example.org/*"
      ],
      "js": [
        "translations.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
